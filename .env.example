# ── قاعدة البيانات ────────────────────────────────
DATABASE_URL="postgresql://visits_app:CHANGE_ME@localhost:5432/visits?schema=public"
POSTGRES_USER=visits_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=visits

# ── المصادقة ─────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
USERNAME_SUFFIX=@dawaa-alhayat

# ── الأمان ───────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── قواعد العمل ──────────────────────────────────
ALLOW_FUTURE_VISIT_DATE=false
MAX_VISIT_BACKDATE_DAYS=30
MAX_REMINDER_PRODUCTS=3
MAX_SAMPLE_PRODUCTS=3

# ── عام ──────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
TZ=Asia/Baghdad
